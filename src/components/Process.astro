---
import { Image } from "astro:assets";
import { stages } from "@/data/site";
import painting from "@/assets/paintings/barberini.jpg";
import drawing from "@/assets/paintings/barberini-ir.jpg";
---

<section class="room" id="process">
  <header class="room__head">
    <span class="room__num">III</span>
    <h2>From daydream to deployed</h2>
  </header>

  <ol class="strip">
    {stages.map((stage, i) => (
      <li class="rise">
        <div class={`crop ${stage.filter}`}>
          <Image
            src={i === 0 ? drawing : painting}
            alt=""
            widths={[400, 640]}
            sizes="(max-width: 760px) 44vw, 23vw"
          />
        </div>
        <h3>{stage.name}</h3>
        <p>{stage.body}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  /* same patch of the cortona four times, finished a bit more each step */
  .strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .crop {
    aspect-ratio: 3 / 4;
    margin-bottom: 1.25rem;
    overflow: hidden;
    background: var(--wall-deep);
  }

  .crop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
    scale: 2.1;
    transform-origin: 50% 62%;
  }

  .sketch :global(img) {
    filter: brightness(1.45) contrast(1.05);
  }

  .grisaille :global(img) {
    filter: grayscale(1) sepia(0.35) contrast(0.9);
  }

  .colour :global(img) {
    filter: saturate(0.6) brightness(1.04);
  }

  .varnish :global(img) {
    filter: saturate(1.15) contrast(1.06);
  }

  h3 {
    margin-bottom: 0.5rem;
    font-size: 1.625rem;
    font-style: italic;
  }

  p {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  @media (max-width: 760px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.5rem;
    }
  }
</style>
