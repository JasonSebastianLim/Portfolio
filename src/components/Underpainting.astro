---
import { layers } from "@/data/site";
---

<section class="band" id="underpainting">
  <div class="room">
    <header class="room__head">
      <span class="room__num">II</span>
      <h2>The underpainting</h2>
      <p class="room__lede">
        The part nobody looks at. L1 tech support at Dewaweb and IT architect work on Dewacloud taught me what happens
        after you press deploy.
        Here's one request, from the domain down.
      </p>
    </header>

    <div class="split">
      <aside class="seal rise">
        <svg viewBox="0 0 120 120" width="120" height="120" aria-hidden="true">
          <g fill="none" stroke="currentColor">
            <circle cx="60" cy="60" r="56" stroke-dasharray="2 5"></circle>
            <circle cx="60" cy="60" r="47"></circle>
          </g>
          <path fill="currentColor" fill-rule="evenodd" d="M60 22l9 29 29 9-29 9-9 29-9-29-29-9 29-9zM60 54a6 6 0 1 0 0 12 6 6 0 0 0 0-12z"></path>
        </svg>
        <p class="seal__title">Ninja of the Month</p>
        <p class="seal__count">May and June 2026, at Dewaweb</p>
      </aside>

      <ol class="stack">
        {layers.map((layer, i) => (
          <li>
            <details name="layer" open={i === 0}>
              <summary>
                <span class="depth mono">{String(i + 1).padStart(2, "0")}</span>
                <span class="layer-name">{layer.name}</span>
                <code class="mono">{layer.record}</code>
              </summary>
              <div class="body">
                <p>{layer.body}</p>
                {layer.note && <p class="note"><span class="small-caps">Field note</span>{layer.note}</p>}
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .band {
    background-color: var(--wall-deep);
    background-image:
      linear-gradient(var(--hairline) 1px, transparent 1px),
      linear-gradient(90deg, var(--hairline) 1px, transparent 1px);
    background-size: 100% 6rem, 6rem 100%;
    background-position: 0 -1px, -1px 0;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(10rem, 15rem) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .seal {
    position: sticky;
    top: 3rem;
    color: var(--gilt);
    text-align: center;
  }

  .seal svg {
    margin-inline: auto;
  }

  .seal__title {
    margin-top: 1rem;
    font: italic 400 1.5rem/1.15 var(--serif);
    color: var(--ink);
  }

  .seal__count {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .stack {
    border-bottom: 1px solid var(--ink);
    background: var(--wall-deep);
  }

  li {
    border-top: 1px solid var(--ink);
  }

  summary {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
    padding-block: 1.1rem;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover .layer-name {
    color: var(--accent);
  }

  .depth {
    color: var(--gilt);
  }

  .layer-name {
    font: 400 clamp(1.375rem, 2.4vw, 1.875rem)/1.15 var(--serif);
    transition: color 0.2s;
  }

  code {
    color: var(--ink-soft);
    white-space: pre;
  }

  .body {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
    padding: 0 0 1.75rem 3.5rem;
  }

  .note {
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    font-size: 0.9375rem;
  }

  .note .small-caps {
    display: block;
    margin-bottom: 0.25rem;
  }

  @media (max-width: 760px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .seal {
      position: static;
      display: grid;
      grid-template-columns: 5rem 1fr;
      column-gap: 1.25rem;
      align-items: center;
      text-align: left;
    }

    .seal svg {
      grid-row: span 2;
      width: 5rem;
      height: 5rem;
    }

    .seal__title {
      align-self: end;
      margin: 0;
    }

    .seal__count {
      align-self: start;
    }

    summary {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.2rem 0.5rem;
    }

    code {
      grid-column: 2;
      font-size: 0.75rem;
      white-space: pre-wrap;
    }

    .body {
      padding-left: 2.5rem;
    }
  }
</style>
