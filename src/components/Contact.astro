---
import { credits, person } from "@/data/site";
---

<footer class="end" id="contact">
  <div class="room">
    <p class="small-caps">Have a daydream that needs structure?</p>
    <h2>Let's work <em>together.</em></h2>
    <p class="mail"><a href={`mailto:${person.email}`}>{person.email}</a></p>
    <ul class="links">
      <li><a href={person.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a></li>
      <li><a href={person.github} rel="noopener noreferrer" target="_blank">GitHub</a></li>
      <li><a href={person.resume}>Resume</a></li>
    </ul>

    <div class="colophon">
      <ul>
        {credits.map((c) => (
          <li>{c.work}, {c.detail}. Photo: <a href={c.href} rel="noopener noreferrer" target="_blank">{c.photo}</a>.</li>
        ))}
      </ul>
      <p>Set in IM Fell Double Pica and Alexandria. Built with Astro, no trackers.</p>
    </div>
  </div>
</footer>

<style>
  .end {
    border-top: 1px solid var(--hairline);
    background: var(--wall-deep);
  }

  h2 {
    margin-block: 1rem 2rem;
    font-size: clamp(3.25rem, 10vw, 9rem);
  }

  h2 em {
    color: var(--accent);
  }

  .mail {
    font: 400 clamp(1.375rem, 3.4vw, 2.5rem)/1.2 var(--serif);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 1.5rem;
    font-weight: 500;
  }

  .colophon {
    display: grid;
    gap: 0.75rem;
    margin-top: var(--room);
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
</style>
