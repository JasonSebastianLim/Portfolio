---
import { Image } from "astro:assets";
import portrait from "@/assets/portrait.jpg";
import { certificates, featuredCertificate as ibm, provenance, tools } from "@/data/site";
---

<section class="room" id="about">
  <header class="room__head">
    <span class="room__num">IV</span>
    <h2>About the daydreamer</h2>
  </header>

  <div class="intro">
    <div class="oval rise">
      <Image src={portrait} alt="Jason Sebastian in a maroon blazer, one finger raised, thinking" widths={[360, 620]} sizes="(max-width: 760px) 70vw, 28vw" />
    </div>
    <div class="story">
      <p class="first">
        I started out designing screens for clients. Then I wanted to build them, then I wanted to know where they
        actually live. So now I do all three, and a design of mine rarely stops at Figma.
      </p>
      <p>
        I'm finishing Business Analytics at BINUS, working at Dewaweb, and building Paramita in whatever hours are left.
        I also help run events at my vihara. When I'm not at a screen I'm swimming laps or planning my next shot at a
        pool table.
      </p>
      <p>
        AI coding agents are part of how I work now. They speed up the building. The design and architecture stay mine,
        and I check what ships.
      </p>
    </div>
  </div>

  <a class="diploma rise" href={ibm.href} rel="noopener noreferrer" target="_blank">
    <span class="small-caps">Certificate, {ibm.date}</span>
    <span class="diploma__title">{ibm.title}</span>
    <span class="diploma__note">{ibm.note}</span>
    <span class="diploma__verify">Verify on Coursera</span>
  </a>

  <div class="records">
    <div>
      <h3 class="small-caps">Provenance</h3>
      <ol class="rows">
        {provenance.map((row) => (
          <li>
            <span class="when">{row.when}</span>
            <span><strong>{row.where}</strong> {row.what}</span>
          </li>
        ))}
      </ol>
    </div>
    <div>
      <h3 class="small-caps">Materials</h3>
      <ol class="rows">
        {tools.map((row) => (
          <li>
            <span class="when">{row.group}</span>
            <span>{row.items}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <details class="certs">
    <summary class="small-caps">Certificates ({certificates.length})</summary>
    <ul>
      {certificates.map((c) => <li>{c.title} <span>{c.issuer}, {c.year}</span></li>)}
    </ul>
  </details>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: center;
    margin-bottom: var(--room);
  }

  /* portrait miniature. the photo is already on black so it sits fine in both themes */
  .oval {
    justify-self: center;
    width: min(100%, 26rem);
    aspect-ratio: 4 / 5;
    padding: 9px;
    border-radius: 50%;
    background: linear-gradient(140deg, #6e4f1a, #c9a658 28%, #8d6b2a 52%, #d7b873 76%, #65481a);
    box-shadow: 0 30px 44px -26px var(--shadow);
  }

  .oval :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    object-position: 46% 12%;
  }

  .story {
    display: grid;
    gap: 1.25rem;
    max-width: var(--measure);
    font-size: 1.0625rem;
  }

  .first::first-letter {
    float: left;
    margin: 0.09em 0.1em 0 0;
    font: 400 4.6em/0.74 var(--serif);
    color: var(--accent);
  }

  /* the one certificate worth framing, the rest stay in the drawer below */
  .diploma {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) auto;
    gap: 0.5rem clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(3rem, 6vw, 5rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--gesso);
    outline: 1px solid var(--gilt);
    outline-offset: -8px;
    box-shadow: 0 14px 24px -18px var(--shadow);
    text-decoration: none;
  }

  .diploma .small-caps {
    grid-column: 1 / -1;
  }

  .diploma__title {
    font: italic 400 clamp(1.75rem, 3.2vw, 2.75rem)/1.08 var(--serif);
  }

  .diploma__note {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .diploma__verify {
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--gilt);
    text-underline-offset: 0.22em;
  }

  .records {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 6rem);
  }

  .records h3 {
    margin-bottom: 1rem;
  }

  .rows li {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.9375rem;
  }

  .when {
    color: var(--ink-soft);
    font-size: 0.8125rem;
  }

  strong {
    display: block;
    font: italic 400 1.25rem/1.25 var(--serif);
  }

  .certs {
    margin-top: 3rem;
    border-top: 1px solid var(--hairline);
    padding-top: 1rem;
  }

  .certs summary {
    cursor: pointer;
  }

  .certs ul {
    columns: 2;
    column-gap: 3rem;
    margin-top: 1rem;
    font-size: 0.9375rem;
  }

  .certs li {
    padding-block: 0.3rem;
    break-inside: avoid;
  }

  .certs span {
    color: var(--ink-soft);
    font-size: 0.8125rem;
  }

  @media (max-width: 760px) {
    .intro,
    .records {
      grid-template-columns: minmax(0, 1fr);
    }

    .oval {
      width: min(72vw, 20rem);
    }

    .diploma {
      grid-template-columns: minmax(0, 1fr);
    }

    .rows li {
      grid-template-columns: 6.5rem minmax(0, 1fr);
    }

    .certs ul {
      columns: 1;
    }
  }
</style>
