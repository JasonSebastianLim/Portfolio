---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpeg,jpg,png,gif}"
);

const heroImageModule = await images["/src/assets/hero-removebg-preview.png"]();
const heroImage = heroImageModule.default;
--- 

<section id="hero-section" class="relative overflow-hidden py-20 flex md:flex-row flex-col px-4 md:px-0 gap-10 md:gap-0">

  <div class="absolute inset-0 z-0 opacity-20 text-pblack hidden md:block" aria-hidden="true">
    <svg 
      width="100%" 
      height="100%" 
      viewBox="0 0 1000 600" 
      preserveAspectRatio="xMidYMid slice" 
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M 400 300 C 500 150, 700 450, 850 300"
        stroke="currentColor"
        fill="none"
        stroke-width="2"
        stroke-linecap="round"
        stroke-dasharray="8 8"
      ></path>
    </svg>
  </div>

  <div class="relative z-10 flex flex-col gap-6 justify-start items-start md:w-1/2">
    <h1 class="text-pblack">Hi, my name is Jason Sebastian.</h1>
    <p class="text-6xl font-bold">Giving structure to a daydream.</p>
    <p>
      I'm a web designer and professional daydreamer.
      I specialize in exploring wild ideas and then focusing them into beautiful, 
      intuitive designs that perfectly capture a client's vision.
      My goal is to meet your requirements; my passion is to make the result even better than you imagined.
    </p>
    <a
      href="/#socials"
      class="bg-pgreen px-5 py-3 border-1 border-black rounded-lg shadow-card hover:shadow-hover transition"
    >
      Let's work together!
    </a>
  </div>

  <div
    id="hero-image-card"
    class="relative z-10 md:w-1/2 object-contain flex items-center justify-center p-10 group"
  >
    <a
      rel="noopener noreferrer"
      href="https://www.linkedin.com/in/jason-sebastian88/"
      target="_blank"
    >
      <div
        class="bg-pblue border-3 border-black rounded-2xl h-52 w-60 shadow-card group-hover:shadow-hover flex transition relative"
      >
        <div
          class="absolute -top-8 -left-12 text-5xl bg-ppink px-5 py-1 z-10 shadow-card group-hover:shadow-hover transition rounded-t-2xl border-3 border-black rounded-bl-2xl rounded-br-sm"
        >
          <Icon name="paint" />
        </div>
        <div
          class="absolute top-16 -right-16 text-5xl bg-pyellow p-2 z-10 shadow-card group-hover:shadow-hover transition rounded-full border-3 border-black"
        >
          <Icon name="beach" />
        </div>
        <div
          class="absolute text-nowrap flex items-center gap-4 -bottom-12 right-0 pr-4 bg-pgreen pl-1 z-10 shadow-card1 group-hover:shadow-card transition rounded-full border-3 border-black"
        >
          <Icon name="beach" />
          <p>Jason Sebastian</p>
        </div>
        <div class="h-80 w-60 overflow-hidden relative -mt-30 rounded-2xl">
          <Image
            class="object-bottom absolute bottom-0 group-hover:scale-105 transition"
            src={heroImage}
            alt="Sorolla, photo wiki"
          />
        </div>
      </div></a
    >
  </div>
</section>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.getElementById("hero-section");
    const imageCard = document.getElementById("hero-image-card");

    if (!section || !imageCard) {
      console.error("Hero parallax elements not found.");
      return;
    }

    function moveElements(e: MouseEvent) {
      const { clientX, clientY } = e;
      const x = (clientX - window.innerWidth / 2) * 0.01; 
      const y = (clientY - window.innerHeight / 2) * 0.01; 

      gsap.to(imageCard, {
        x: x,
        y: y,
        ease: "power1.out",
        duration: 0.5,
      });
    }

    section.addEventListener("mousemove", moveElements);
  });
</script>

<style>
  #hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(#4E6273 1px, transparent 1px);
    background-size: 20px 20px;
    background-position: center;
    opacity: 0.2;
    z-index: -1;
  }
</style>
